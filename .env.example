# Copy this file to .env in the repo root and fill in only what you use.
# The app loads .env automatically at startup (API, CLI, and demo).
# A variable set in the real environment always takes precedence over .env.
#
# ===========================================================================
# LEAD PROFILE — NVIDIA NIM (this blueprint is built on NIM)
# ===========================================================================
# NIM endpoints are OpenAI-compatible, hosted and self-hosted alike.
# Hosted: build.nvidia.com issues an `nvapi-` key for
# https://integrate.api.nvidia.com/v1. Self-hosted: run the NIM
# containers and point the base URLs at them (see docker-compose.local.yml).
# The model names below were verified live against the hosted
# catalog on 2026-10-10 (full pipeline: OCR read, vision verdict,
# extraction, diagnosis). Hosted catalog names rotate — the names
# this file shipped with originally were retired by NVIDIA in
# August 2026; if a name returns 410/404, pick its successor on
# build.nvidia.com.
#
# --- Nemotron LLM (reasoning, extraction, drafting) ---
MODEL_BACKEND=openai
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_API_KEY=nvapi-your-key-here
OPENAI_MODEL=nvidia/nemotron-3-super-120b-a12b
#
# --- Nemotron OCR (document text layer) ---
# OCR_ENGINE=nim
# OCR_BASE_URL=https://integrate.api.nvidia.com/v1
# OCR_MODEL=nvidia/nemotron-3-super-120b-a12b
# NVIDIA_API_KEY=nvapi-your-key-here        (shared by the OCR/vision engines)
#
# --- Nemotron vision-language model (document type + legibility) ---
# VISION_ENGINE=nim
# VISION_BASE_URL=https://integrate.api.nvidia.com/v1
# VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
#
# --- NV-Embed (semantic / hybrid retrieval over pgvector) ---
# RETRIEVER=hybrid
# OPENAI_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
# (embeddings use the same OpenAI-compatible endpoint + key as above)
#
# The offline fallback (MODEL_BACKEND unset / mock, OCR_ENGINE and
# VISION_ENGINE unset) runs the same pipeline with deterministic
# templates and the documents' provided text layer — a smoke test of
# the plumbing, not the product.

# ===========================================================================
# Other providers (the engine is portable; NIM is the lead profile)
# ===========================================================================
# MODEL_BACKEND=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5
#
# MODEL_BACKEND=openai            (plain OpenAI, or any compatible host)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=                (set for Azure / gateways / vLLM / NIM)
#
# MODEL_BACKEND=ollama            (local / sovereign)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ===========================================================================
# Production state — PostgreSQL is the system of record
# ===========================================================================
# Approvals store AND LangGraph checkpointer AND policy vectors
# (pgvector) all live in this one database. Migrations (migrations/)
# run at startup. Unset = in-memory test doubles (local hacking only;
# nothing persists).
# DATABASE_URL=postgresql://ap:ap@localhost:5432/ap
#
# Document blobs: S3-compatible object storage. Documents reference
# object keys; the OCR stage resolves them through this port.
# Unset = object storage disabled (documents must carry their text).
# S3_ENDPOINT_URL=http://localhost:9000     (MinIO; omit for AWS S3)
# S3_BUCKET=ap-documents
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1

# ===========================================================================
# Behaviour knobs (all optional)
# ===========================================================================
# RETRIEVER=keyword               keyword | semantic | hybrid (RRF fusion)
# CHECKPOINTS=on                  off disables the LangGraph checkpointer
# REVIEWER=on                     off disables the independent reviewer
# REVIEWER_MODEL=                 reviewer model override (else the backend's)
# GUARDRAIL_REPAIR=on             bounded redraft loop on guardrail failure
# GUARDRAIL_REPAIR_MAX_ATTEMPTS=2
# RUN_TOKEN_BUDGET=               per-run token budget; over it, later
#                                 provider steps degrade to templates
# DIAGNOSIS_MAX_TOOL_CALLS=4      bounded tool loop (hard cap 6)
# NODE_TIMEOUT_SECONDS=           per-node wall-clock cap (off when unset)
# LLM_TIMEOUT_SECONDS=60          per-call provider timeout
# API_KEY=                        set to require X-API-Key on data endpoints
# ACTION_WEBHOOK_URL=             POSTed once on approval (opt-in), and
#                                 by the recovery-escalation sweep when a
#                                 case breaches its SLA; the ONLY external
#                                 action the agent can take
# ACTION_WEBHOOK_SECRET=          when set, the webhook body is signed:
#                                 X-Trida-Signature: sha256=<HMAC-SHA256
#                                 hex of the body> for the receiver to
#                                 verify origin and integrity
# ACTION_WEBHOOK_TIMEOUT_SECONDS=10
# COST_OF_CAPITAL_ANNUAL_PCT=6    cost of capital used to price
#                                 early-payment discounts (discounts.py)
# PAYMENT_RUN_FOUR_EYES_THRESHOLD=25000
#                                 a payment run whose net total is
#                                 above this needs a second confirmer
#                                 (different from the first) before its
#                                 hand-off file can be generated
# PAYMENT_RUN_FOUR_EYES_THRESHOLDS=EUR=50000,JPY=3000000
#                                 per-currency four-eyes thresholds;
#                                 the global value above is the
#                                 fallback for unlisted currencies
# FOUR_EYES_WAIT_BUDGETS=EUR=1000,USD=500
#                                 per-currency MONTHLY budgets for
#                                 the priced four-eyes wait: the
#                                 discount value second-confirmation
#                                 waits may destroy per month before
#                                 /metrics and the digest name the
#                                 breach; unlisted currencies are
#                                 unbudgeted (reported, never over)
# RECOVERY_CASE_SLA_DAYS=14       a recovery case sitting in one
#                                 status longer than this is flagged
#                                 as stuck in the queue and metrics
# MASTER_CHANGE_EXPIRY_DAYS=30    a pending supplier-master change
#                                 undecided for longer than this
#                                 expires and must be re-proposed
# MASTER_CHANGE_EXPIRY_WARNING_DAYS=7
#                                 with this many days (or fewer) of
#                                 its decision window left, a pending
#                                 change is flagged expiring soon on
#                                 the worklist and named in the
#                                 digest — decision owed, window
#                                 closing
# POSTING_RECEIPT_GRACE_DAYS=7    an approved invoice with no posted
#                                 receipt after this many days is
#                                 reported as an ERP open item
# POSTING_ESCALATION_DAYS=21      an open posting older than this
#                                 escalates into the approver queue
#                                 as an action item (never below the
#                                 grace window above); the escalation
#                                 sweep's ladder fires posting_
#                                 escalation at this threshold and
#                                 posting_escalation_urgent at twice it
# DIGEST_STORE_LOOKBACK_DAYS=7    the digest auto-store sweep pins
#                                 unstored digests for this many
#                                 recent days (today included)
# PAYMENT_RUN_FOUR_EYES_AGING_DAYS=2
#                                 a four-eyes run waiting longer
#                                 than this for its second confirmer
#                                 joins the approver queue as an
#                                 action item, first confirmer named
# LOG_FORMAT=json                 json (default) | text
# LOG_LEVEL=INFO
